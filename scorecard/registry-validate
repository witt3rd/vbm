#!/usr/bin/env python3
"""Validate registry entries (scorecard/SPEC.md, "Registry and contribution flow"). Executes nothing of any subject; reads only the entry files.
  scorecard/registry-validate [--allowlist FILE] [--pr-file F...] [--base-root DIR] ENTRY...
Each ENTRY is checked against the schema (the common keys kind, status, what, milestone, depends_on are required; repo, commit, manifest, targets and [latest] are required for a live entry and forbidden otherwise, where the entry is unscored; the [measured] table is optional, unknown keys rejected), against the ALLOWLIST (registry/allowlist.toml; SPEC rule 10: until the Level 2 isolation exists
only our repos are accepted) and against the monthly cap on approved Level 2 requests. With --pr-files (the changed-file list of a contribution PR) the PR must change exactly ONE file, a registry/<owner>__<repo>.toml
entry, and its [latest] block must equal the one in --base-root (the main branch checkout) or be unscored for a new entry: a contributor can never write a score. Exit 0 valid, 1 invalid (one finding per line)."""
import glob, os, re, sys, tomllib

COMMON = {"kind": str, "status": str, "what": str, "milestone": str, "depends_on": list}   # every entry: a library, tool or foundation piece, listed before or after it is public
KINDS = ("library", "foundation", "tool"); STATUS = ("live", "coming soon", "planned")
SCORING = {"repo": str, "commit": str, "manifest": str, "targets": list, "latest": {"date": str, "correctness": str, "landedness": str, "level": str, "card": str}}   # only a live (public) entry carries them; without them the entry is unscored
SCHEMA = {**COMMON, **SCORING}
MEASURED = {"reason": str, "adapter": str, "approved": str}      # the OPTIONAL Level 2 request (SPEC, "Level 2: Measured")
NAME = re.compile(r"^([A-Za-z0-9][A-Za-z0-9._-]*)__([A-Za-z0-9][A-Za-z0-9._-]*)\.toml$")
PENDING = {"date": "", "correctness": "pending", "landedness": "pending", "level": "pending", "card": ""}
UNSCORED = {"date": "", "correctness": "unscored", "landedness": "unscored", "level": "unscored", "card": ""}   # two verdicts, never one blended score (DECISIONS 18)
LEVELS = ("none", "certified", "certified+measured")
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REFUSED = "not allowlisted: outside submissions wait for the Level 2 isolation (scorecard/SPEC.md, 'Level 2 isolation (the required design)')"


def load(path):
    with open(path, "rb") as f: return tomllib.load(f)


def allowlist(path):
    try: d = load(path)
    except (OSError, tomllib.TOMLDecodeError) as e: raise SystemExit(f"registry-validate: the allowlist {path} is not readable TOML: {e}")
    if set(d) != {"repos", "measured_per_month"} or not isinstance(d["repos"], list) or not all(isinstance(r, str) for r in d["repos"]) or isinstance(d["measured_per_month"], bool) or not isinstance(d["measured_per_month"], int) or d["measured_per_month"] < 0:
        raise SystemExit(f"registry-validate: the allowlist {path} must hold exactly repos = [\"owner/repo\", ...] and measured_per_month = N")
    return d


def check(path, bad, allow):
    base = os.path.basename(path); m = NAME.match(base)
    if not m: return bad.append(f"{path}: the file name must be <owner>__<repo>.toml")
    try: d = load(path)
    except (OSError, tomllib.TOMLDecodeError) as e: return bad.append(f"{path}: not readable TOML: {e}")
    live = d.get("status") == "live"
    listed = live and d.get("kind") == "tool"   # a live TOOL is listed and linked (repo) and never scored: the scoring keys are for a library or foundation piece
    for k, t in SCHEMA.items():
        if k not in d:
            if k in COMMON or (live and (k == "repo" or not listed)): bad.append(f"{path}: missing key {k}")
            continue
        if listed and k in SCORING and k != "repo": bad.append(f"{path}: {k} is not allowed on a tool entry (a tool is listed and linked, never scored)"); continue
        if k in SCORING and not live: bad.append(f"{path}: {k} is only allowed when status is live (a private repo is never linked or scored)"); continue
        if isinstance(t, dict):
            if not isinstance(d[k], dict): bad.append(f"{path}: [{k}] must be a table"); continue
            for kk, tt in t.items():
                if not isinstance(d[k].get(kk), tt): bad.append(f"{path}: [{k}] {kk} missing or not a string")
            bad += [f"{path}: unknown key [{k}] {x}" for x in d[k] if x not in t]
        elif not isinstance(d[k], t): bad.append(f"{path}: {k} must be a {t.__name__}")
    if "measured" in d:
        if not isinstance(d["measured"], dict): bad.append(f"{path}: [measured] must be a table")
        else:
            bad += [f"{path}: [measured] {kk} missing or not a string" for kk, tt in MEASURED.items() if not isinstance(d["measured"].get(kk), tt)]
            bad += [f"{path}: unknown key [measured] {x}" for x in d["measured"] if x not in MEASURED]
    bad += [f"{path}: unknown key {x}" for x in d if x not in SCHEMA and x != "measured"]
    if "measured" in d and (not live or listed): bad.append(f"{path}: [measured] is only allowed when status is live and the kind is not tool")
    if d.get("kind") not in KINDS: bad.append(f"{path}: kind must be one of {', '.join(KINDS)}")
    if d.get("status") not in STATUS: bad.append(f"{path}: status must be one of {', '.join(STATUS)}")
    if bad and any(b.startswith(path) for b in bad): return
    owner, repo = m.group(1), m.group(2)
    if not d["what"].strip() or not d["milestone"].strip() or not all(isinstance(x, str) and x for x in d["depends_on"]): bad.append(f"{path}: what and milestone are non-empty strings, depends_on a list of names")
    if not live:
        if owner not in {r.split("/")[0] for r in allow["repos"]}: bad.append(f"{path}: owner {owner} is {REFUSED}")
        return
    if d["repo"] != f"https://github.com/{owner}/{repo}": bad.append(f"{path}: repo must be https://github.com/{owner}/{repo} (the file name says so)")
    if f"{owner}/{repo}" not in allow["repos"]: bad.append(f"{path}: {owner}/{repo} is {REFUSED}")
    if listed: return
    if not re.fullmatch(r"[0-9a-f]{40}", d["commit"]): bad.append(f"{path}: commit must be a full 40-hex SHA")
    if not d["targets"] or not all(isinstance(t, str) and re.fullmatch(r"[A-Za-z0-9+#. -]{1,24}", t) for t in d["targets"]): bad.append(f"{path}: targets must be a non-empty list of short language names (the languages the repo claims to build for)")
    rel = lambda v: not v.startswith("/") and ".." not in v.split("/") and "\0" not in v and v.endswith(".toml")
    if not rel(d["manifest"]): bad.append(f"{path}: manifest must be a relative .toml path without '..'")
    if "measured" in d:
        ms = d["measured"]
        if not rel(ms["adapter"]): bad.append(f"{path}: [measured] adapter must be a relative .toml path without '..'")
        if len(ms["reason"].strip()) < 40: bad.append(f"{path}: [measured] reason must say, in at least 40 characters, why this repo needs measured numbers (Level 2 is by special consideration)")
        if ms["approved"] and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", ms["approved"]): bad.append(f"{path}: [measured] approved is empty or a YYYY-MM-DD date")
        elif ms["approved"]:
            month = ms["approved"][:7]; n = 0
            for sib in glob.glob(os.path.join(os.path.dirname(os.path.abspath(path)), "*__*.toml")):
                try: sm = load(sib).get("measured", {})
                except (OSError, tomllib.TOMLDecodeError): continue
                n += isinstance(sm, dict) and str(sm.get("approved", ""))[:7] == month
            if n > allow["measured_per_month"]: bad.append(f"{path}: {n} Level 2 approvals in {month} exceed measured_per_month = {allow['measured_per_month']} (registry/allowlist.toml)")
    l = d["latest"]
    if l["level"] not in LEVELS + ("unscored", "pending"): bad.append(f"{path}: [latest] level must be one of none, certified, certified+measured, unscored, pending")
    cv, lv = l["correctness"], l["landedness"]
    if cv == "unscored" and lv == "unscored":
        if l != UNSCORED: bad.append(f"{path}: an unscored entry has an empty date and card, and level unscored")
    elif cv == "pending" and lv == "pending":
        if l != PENDING: bad.append(f"{path}: a pending entry has an empty date and card, and level pending")
    elif cv in ("pass", "fail") and lv in ("pass", "fail", "pending"):   # a scored card always has a correctness verdict; landedness is pending for a card scored before the warm/cold split
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", l["date"]) or l["card"] != f"registry/scores/{owner}__{repo}.json": bad.append(f"{path}: a scored entry needs a YYYY-MM-DD date and card registry/scores/{owner}__{repo}.json")
        if l["level"] not in LEVELS: bad.append(f"{path}: a scored entry has a level of none, certified or certified+measured")
        if l["level"] == "certified+measured" and not ("measured" in d and d["measured"]["approved"]): bad.append(f"{path}: certified+measured needs an approved [measured] request")
    else: bad.append(f"{path}: [latest] correctness must be pass or fail and landedness pass, fail or pending for a scored entry (both pending or both unscored otherwise)")


def main(argv):
    import argparse
    a = argparse.ArgumentParser(prog="registry-validate"); a.add_argument("--pr-file", action="append"); a.add_argument("--base-root"); a.add_argument("--allowlist", default=os.path.join(ROOT, "registry", "allowlist.toml")); a.add_argument("entries", nargs="*")
    a = a.parse_args(argv); bad = []; allow = allowlist(a.allowlist)
    for e in a.entries: check(e, bad, allow)
    if a.pr_file is not None:
        ok = [f for f in a.pr_file if NAME.fullmatch(os.path.basename(f)) and re.fullmatch(r"registry/[^/]+\.toml", f)]
        if len(a.pr_file) != 1 or len(ok) != 1: bad.append(f"a registry PR changes exactly ONE registry/<owner>__<repo>.toml and nothing else (scripts, workflows, scores, other entries are refused): {a.pr_file}")
        elif a.base_root:
            old = os.path.join(a.base_root, ok[0]); new = [e for e in a.entries if e.endswith(ok[0])]
            was = load(old).get("latest", UNSCORED) if os.path.exists(old) else UNSCORED
            if not new: bad.append(f"the changed entry {ok[0]} was not given to validate")
            elif load(new[0]).get("latest", UNSCORED) != was: bad.append(f"{ok[0]}: [latest] differs from main: only the scoring job writes a score")
            else:
                ap = lambda p: (load(p).get("measured") or {}).get("approved", "") if os.path.exists(p) else ""
                if ap(new[0]) != ap(old): bad.append(f"{ok[0]}: [measured] approved differs from main: only a maintainer approves a Level 2 request")
    if bad: print("\n".join(bad))
    return 1 if bad else 0


if __name__ == "__main__": sys.exit(main(sys.argv[1:]))

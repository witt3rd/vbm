#!/usr/bin/env python3
"""The registry table of README.md, generated from registry/*.toml and the cards they point to (the source of truth is those files; README.md is a render, never a second source).
  scorecard/registry-table [--root DIR]                print the table (markdown)
  scorecard/registry-table [--root DIR] --write FILE   replace the text between the markers in FILE, and write each scored card's page (card.md next to its JSON: the Card column links to it, the JSON link lives inside it)
  scorecard/registry-table [--root DIR] --check FILE   exit 1 if FILE's table differs from the generated one (hand-edited score, stale table)
An entry with no [latest] (every entry that is not live, or a live one not yet scored) renders as unscored. Consistency is enforced here too: depends_on names a listed entry; a scored entry's card must exist, its correctness and landedness verdicts (derived from the card's dimensions) must equal the entry's [latest] ones and its subject commit must equal the entry's pinned commit. Executes nothing of any subject."""
import argparse, glob, json, os, re, sys, tomllib

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import scorecard_verdicts, scorecard_card_md
from scorecard_verdicts import label

BEGIN = "<!-- registry:begin (generated by scorecard/registry-table from registry/*.toml; do not edit by hand) -->"
END = "<!-- registry:end -->"
ORDER = {"foundation": 0, "tool": 0, "library": 1}


def pdfs(root, c, d):
    """The card's one-page PDF (the docs/cards/<name>-vN whose card.json is this card) and the other versions, as links relative to the page's directory."""
    up = os.path.relpath(os.path.join(root, "docs", "cards"), os.path.join(root, d)); vs = []
    for f in glob.glob(os.path.join(root, "docs", "cards", c["subject"]["name"] + "-v*.pdf")):
        m = re.fullmatch(r".*-v(\d+)\.pdf", f)
        if m: vs.append((int(m.group(1)), f))
    cur, prev = "", []
    for n, f in sorted(vs, reverse=True):
        j = f[:-4] + "/card.json"; u = f"{up}/{os.path.basename(f)}"
        if not cur and os.path.isfile(j) and json.load(open(j)) == c: cur = u
        else: prev.append((f"v{n}", u))
    return cur, prev


def table(root, pages=None):
    es = []
    for path in sorted(glob.glob(os.path.join(root, "registry", "*__*.toml"))):
        e = tomllib.load(open(path, "rb")); e["name"] = os.path.basename(path)[:-5].split("__", 1)[1]; e["path"] = path; es.append(e)
    names = [e["name"] for e in es]
    out = ["| Name | What it is | Kind | Status | Correctness | Landedness | Card |", "|---|---|---|---|---|---|---|"]
    for e in sorted(es, key=lambda e: (ORDER.get(e.get("kind"), 2), e["name"])):
        path = e["path"]
        for dep in e.get("depends_on", []):
            if dep not in names: raise SystemExit(f"registry-table: {path}: depends_on {dep} is not a listed entry")
        l = e.get("latest", {"correctness": "unscored", "landedness": "unscored"})
        name = f"[{e['name']}]({e['repo']})" if "repo" in e else e["name"]
        cv, lv, card = "unscored", "unscored", "-"
        if l["correctness"] == "pending": cv = lv = "pending"
        elif l["correctness"] != "unscored":
            cp = os.path.join(root, l["card"])
            if not os.path.isfile(cp): raise SystemExit(f"registry-table: {path}: the card {l['card']} does not exist")
            c = json.load(open(cp)); vd = scorecard_verdicts.verdicts(c)   # the verdicts are derived from the card's dimensions, never trusted from the entry
            for k in ("correctness", "landedness"):
                if vd[k]["status"] != l[k]: raise SystemExit(f"registry-table: {path}: [latest] {k} {l[k]} disagrees with its card ({vd[k]['status']})")
            if c["subject"]["commit"] != e["commit"]: raise SystemExit(f"registry-table: {path}: the card scores {c['subject']['commit'][:12]}, the entry pins {e['commit'][:12]}")
            show = lambda k: f"**{vd[k]['status'].upper()}**" + (label(vd[k], short=True)[len(vd[k]["status"]):] if k == "correctness" else "") if vd[k]["status"] != "pending" else "pending"   # Correctness states its coverage
            cv, lv, card = show("correctness"), show("landedness"), f"[card]({l['card'][:-5]}.md)"
            if pages is not None: pages[l["card"][:-5] + ".md"] = scorecard_card_md.render(c, e.get("repo", ""), *pdfs(root, c, os.path.dirname(l["card"])), raw=os.path.basename(l["card"]))
        out.append("| " + " | ".join([name, e["what"], e["kind"], e["status"], cv, lv, card]) + " |")
    return "\n".join(out)


def splice(text, new):
    i, j = text.find(BEGIN), text.find(END)
    if i < 0 or j < i: raise SystemExit("registry-table: the begin/end markers are missing from the file")
    return text[:i] + BEGIN + "\n" + new + "\n" + text[j:]


def main():
    a = argparse.ArgumentParser(); a.add_argument("--root", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__)))); g = a.add_mutually_exclusive_group(); g.add_argument("--write"); g.add_argument("--check")
    a = a.parse_args(); pages = {}; t = table(a.root, pages)
    if a.write:
        p = os.path.join(a.root, a.write); new = splice(open(p).read(), t); open(p, "w").write(new)   # read and splice BEFORE the file is opened for writing
        for f, x in pages.items(): open(os.path.join(a.root, f), "w").write(x)
    elif a.check:
        text = open(os.path.join(a.root, a.check)).read()
        for f, x in pages.items():
            fp = os.path.join(a.root, f)
            if not os.path.isfile(fp) or open(fp).read() != x: print(f"registry-table: {f} differs from the page generated from its card JSON: run scorecard/registry-table --write {a.check} (a card page is a render, never hand-edited, never stale)", file=sys.stderr); return 1
        if splice(text, t) != text: print(f"registry-table: {a.check} differs from the table generated from registry/*.toml: run scorecard/registry-table --write {a.check} (scores are never hand-edited)", file=sys.stderr); return 1
    else: print(t)
    return 0


if __name__ == "__main__": sys.exit(main())

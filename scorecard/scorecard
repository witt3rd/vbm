# DECISIONS 5: a hand-written test is any executable case or expected-output file not produced by a generator from the spec. Default patterns; the adapter adds tests.extra and
# names tests.generated (boundary evidence: generated vectors, a vendored corpus), which is subtracted.
TEST_PATTERNS = ["**/test/**", "**/tests/**", "**/testdata/**", "**/fixtures/**", "**/golden/**", "**/*_test/**", "**/test_*", "**/*_test", "**/*_test.*", "**/*.test.*", "**/*_spec.*", "**/*.spec.*",
                 "**/*Test.*", "**/*Tests.*", "**/*.golden"]


def gre(pat):   # a glob (* within a segment, ** across segments, ?) as an anchored regex
    out, i = "", 0
    while i < len(pat):
        if pat.startswith("**/", i): out += "(?:.*/)?"; i += 3
        elif pat.startswith("**", i): out += ".*"; i += 2
        elif pat[i] == "*": out += "[^/]*"; i += 1
        elif pat[i] == "?": out += "[^/]"; i += 1
        else: out += re.escape(pat[i]); i += 1
    return re.compile(out + r"\Z")


def matching(ctx, pats):
    rs = [gre(x) for x in pats]
    return sorted(p for p in git(ctx["wt"], "ls-files", "-z").split("\0") if p and any(r.match(p) for r in rs))


def safe_read(ctx, rel, cap=MAX_FILE):
    """The one guard for reading a declared file of the subject: relative, no `..`, no symlink (the file or any parent), a regular file, at most MAX_FILE bytes. Returns bytes, or None (recorded in the card's skipped_files)."""
    wt = os.path.realpath(ctx["wt"]); p = os.path.join(wt, rel)
    why = None
    if os.path.isabs(rel) or ".." in rel.split("/"): why = "unsafe path"
    else:
        try: st = os.lstat(p)
        except OSError: ctx["skipped"].add(f"{rel}: not present at the pinned commit"); return None
        if not stat.S_ISREG(st.st_mode) or os.path.realpath(os.path.dirname(p)) != os.path.dirname(p): why = "a symlink or not a regular file"
        elif st.st_size > cap: why = f"over {cap} bytes"
    if why: ctx["skipped"].add(f"{rel}: {why}"); return None
    with open(p, "rb") as f: return f.read()


def tail(out, n=240):   # the end of a subject command's (untrusted) output, one line, for a failure reason
    return " ".join(out.split())[-n:]


def run_cmd(ctx, cmd, timeout, nonce=None, marks=None):
    """Subject code runs ONLY through the sandbox launcher (SPEC, Untrusted subject code); with none configured, nothing executes. The launcher gets a clean environment and a fixed argument shape, and must attest."""
    if not ctx["sandbox"]: raise NotMeasurable("subject code runs only inside the sandbox and no launcher is configured (--sandbox): nothing was executed")
    secs = min(timeout, MAX_SECONDS); ctx["n_exec"] += 1; out = os.path.join(ctx["scratch"], f"out{ctx['n_exec']}"); os.mkdir(out)
    lim = dict(LIMITS, timeout_seconds=secs)
    argv = [ctx["sandbox"], "--subject", ctx["wt"], "--out", out, "--timeout", str(secs), "--cpus", str(lim["cpus"]), "--memory-mb", str(lim["memory_mb"]), "--disk-mb", str(lim["disk_mb"]), "--pids", str(lim["pids"]), "--net", "none", "--", cmd]
    rc, text, t = sh(argv, secs + int(os.environ.get("SCORECARD_GRACE_SECONDS", "30")), {"PATH": "/usr/bin:/bin", "LANG": "C", "HOME": ctx["scratch"]}, nonce=nonce, marks=marks)
    try:
        raw = open(os.path.join(out, "attestation.json"), "rb").read(65536); att = json.loads(raw)
        bad = [k for k, v in (("network", "none"), ("subject_mount", "ro"), ("limits", lim)) if att.get(k) != v] + ([] if isinstance(att.get("image_digest"), str) and att["image_digest"] else ["image_digest"])
    except (OSError, ValueError, AttributeError): raise NotMeasurable("the sandbox wrote no valid attestation.json: its result is not trusted")
    if bad: raise NotMeasurable(f"the sandbox attestation does not match the contract ({', '.join(bad)}): its result is not trusted")
    ctx["attestations"].append(att)
    return rc, text, t


def tier1_script(t, nonce):
    """The wrapper the RUNNER writes around the adapter's gate commands, run as the one command of one sandbox: cold, then (when declared) the typical change, then the warm gate. Each phase is a child `bash -c` under its own wall limit;
    the wrapper prints a nonce-stamped line between phases and the runner times them on the host clock (see sh). The cold run's working copy stays in /tmp for the warm phase (the cache the warm run is primed by)."""
    q = shlex.quote
    def phase(label, cmd, limit):
        return (f'printf "\\n@@scorecard {nonce} {label}-start 0\\n"; timeout -s KILL {int(limit)} bash -c {q(cmd)}; rc=$?; [ $rc != 137 ] || rc=124; printf "\\n@@scorecard {nonce} {label}-end %s\\n" $rc\n')
    s = phase("cold", t["command"], t["timeout_seconds"])
    if t["warm_command"]: s += '[ $rc = 0 ] || exit $rc\n' + phase("change", t["warm_change_cmd"], t["warm_timeout_seconds"]) + '[ $rc = 0 ] || exit $rc\n' + phase("warm", t["warm_command"], t["warm_timeout_seconds"])
    return s + "exit $rc\n"


def tier1_run(ctx):   # memoised: the closure gate runs after it (on a build of its own); returns the COLD run (rc, output, seconds); ctx["phases"] holds every phase
    if "tier1" not in ctx:
        t = ctx["adapter"]["tier1"]; nonce = secrets.token_hex(8); marks = []
        total = t["timeout_seconds"] + (2 * t["warm_timeout_seconds"] if t["warm_command"] else 0)
        rc, out, secs = run_cmd(ctx, tier1_script(t, nonce), total, nonce=nonce, marks=marks)
        ph, cur, rx = {}, None, re.compile(rf"@@scorecard {nonce} (cold|change|warm)-(start|end) (-?\d+)$")
        for line in out.split("\n"):
            m = rx.match(line)
            if m and m.group(2) == "start": cur = m.group(1); ph[cur] = {"out": [], "rc": None, "secs": None}
            elif m: cur = None
            elif cur: ph[cur]["out"].append(line)
        stamp = {}   # the FIRST start line and the LAST end line of a phase count: the wrapper's own lines bracket the subject's command, so a line the subject prints (it can read the nonce from its parent's command line) can only widen a phase, never shorten it
        for l, r, tm in marks:
            if l.endswith("-start"): stamp.setdefault(l, (r, tm))
            else: stamp[l] = (r, tm)
        for name, d in ph.items():
            d["out"] = "\n".join(d["out"]).strip("\n")
            if name + "-end" in stamp:
                r, te = stamp[name + "-end"]; d["rc"] = None if r == 124 else r; d["secs"] = round(te - stamp[name + "-start"][1], 1)
        if "cold" not in ph: ph["cold"] = {"out": out, "rc": rc, "secs": secs}   # the wrapper never ran (a launcher failure): the whole run is the cold one, as before
        elif ph["cold"]["secs"] is None: ph["cold"].update(rc=rc, secs=secs)   # the run ended inside the cold phase (a flood or the outer limit)
        ctx["phases"], ctx["tier1"] = ph, (ph["cold"]["rc"], ph["cold"]["out"], ph["cold"]["secs"])
    return ctx["tier1"]



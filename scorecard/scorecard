MUT_OPS = {"==": "!=", "!=": "==", "<=": "<", ">=": ">", "<": "<=", ">": ">=", "&&": "||", "||": "&&", "+": "-", "-": "+"}
MUT_TOKEN = re.compile(r"<<=|>>=|\+\+|--|->|<<|>>|\+=|-=|==|!=|<=|>=|&&|\|\||<|>|\+|-")   # compound operators are consumed so they are never mutated as their parts
# the in-sandbox loop (the only thing sent to the sandbox): apply one mutant at a time to a COPY of the subject, run the harness, restore. rc 0 = survived, 99 = not viable, anything else (a timeout included) = killed
MUT_LOOP = """import base64, json, os, shutil, subprocess, sys, tempfile
spec = json.loads(base64.b64decode(sys.argv[1]))
src = os.getcwd(); w = os.path.join(tempfile.mkdtemp(), "w"); shutil.copytree(src, w, symlinks=True); os.chdir(w)
def run(cmd, t):
    try: return subprocess.run(["bash", "-c", cmd], timeout=t, capture_output=True).returncode
    except subprocess.TimeoutExpired: return 124
if spec["setup"] and run(spec["setup"], spec["total"]): print("SETUP-FAILED"); sys.exit(0)
print("BASELINE", run(spec["kill"], spec["kt"]), flush=True)
for i, (f, line, col, old, new) in enumerate(spec["mutants"]):
    lines = open(f).read().split("\\n"); orig = lines[line]
    if orig[col:col + len(old)] != old: print("MUTANT", i, 99, flush=True); continue
    lines[line] = orig[:col] + new + orig[col + len(old):]; open(f, "w").write("\\n".join(lines))
    rc = run(spec["kill"], spec["kt"]); lines[line] = orig; open(f, "w").write("\\n".join(lines)); print("MUTANT", i, rc, flush=True)
"""


def mutation_sites(ctx, files, comment):
    sites = []
    for f in files:
        data = safe_read(ctx, f)
        if data is None: continue
        for ln, line in enumerate(data.decode(errors="replace").split("\n")):
            code, q, k = "", None, 0
            for ch in line:   # blank out comments' tails and string/char literals so only code is mutated
                if q: q = None if ch == q else q; code += " "
                elif ch in "\"'": q = ch; code += " "
                else: code += ch
            cut = code.find(comment) if comment else -1; code = code if cut < 0 else code[:cut]
            if code.lstrip().startswith(("*", "/*", "#")): continue
            for m in MUT_TOKEN.finditer(code):
                if m.group() in MUT_OPS: sites.append((f, ln, m.start(), m.group(), MUT_OPS[m.group()]))
    return sites


def run_mutation(ctx, sec):
    mu = ctx["adapter"][sec]
    if not mu["kill_cmd"]: raise NotMeasurable(f"the subject declares no mutation harness (adapter [{sec}] kill_cmd is empty)")
    sites = mutation_sites(ctx, matching(ctx, mu["files"]), mu["comment"])
    if not sites: raise NotMeasurable(f"no mutable operator site in the declared [{sec}] files")
    picked = sorted(random.Random(mu["seed"]).sample(sites, min(mu["mutants"], len(sites))))
    total = min(mu["timeout_seconds"], MAX_SECONDS)
    arg = base64.b64encode(json.dumps({"setup": mu["setup_cmd"], "kill": mu["kill_cmd"], "kt": mu["kill_timeout_seconds"], "total": total, "mutants": picked}).encode()).decode()
    rc, out, _ = run_cmd(ctx, "python3 -c " + shlex.quote(MUT_LOOP) + " " + arg, total)
    if rc in (None, 124): raise Fail(f"{sec} run timed out after {total} s")
    if "SETUP-FAILED" in out: raise NotMeasurable(f"the {sec} setup command failed on the unmutated subject")
    base = re.search(r"^BASELINE (\d+)$", out, re.M)
    if not base or base.group(1) != "0": raise NotMeasurable("the harness fails on the UNMUTATED subject (or did not run): a kill proves nothing")
    res = {int(i): int(c) for i, c in re.findall(r"^MUTANT (\d+) (\d+)$", out, re.M)}
    if len(res) != len(picked): raise NotMeasurable(f"only {len(res)} of {len(picked)} mutant results came back before the time limit")
    killed = sum(1 for c in res.values() if c not in (0, 99)); surv = [i for i, c in res.items() if c == 0]; nonviable = sum(1 for c in res.values() if c == 99)
    if killed + len(surv) == 0: raise NotMeasurable("no viable mutants (every mutant was reported not viable)")
    eq, rejected = equivalents(ctx, mu["equivalent"], {mutant_id(picked[i]): i for i in surv})
    open_ = [i for i in surv if mutant_id(picked[i]) not in eq]
    return round(100 * killed / (killed + len(open_)), 1), {"mutants": len(picked), "killed": killed, "survived": len(surv), "not_viable": nonviable, "sites_total": len(sites), "equivalent": sorted(eq), "rejected_equivalents": rejected,
                                                            "survivors": [f"{picked[i][0]}:{picked[i][1] + 1} {picked[i][3]} -> {picked[i][4]}" for i in sorted(open_)[:20]]}


def mutant_id(site): return f"{site[0]}:{site[1] + 1}:{site[2]}:{site[3]}:{site[4]}"   # file:line:col:old:new (line 1-based, column 0-based): two equal swaps on one line differ by the column


def equivalents(ctx, path, surviving):
    """The subject's list of EQUIVALENT mutants (adapter `equivalent`, a tracked file): lines `id TAB reason TAB expiry`, `#` comments. An entry counts only if it has a reason of 20+ characters, an expiry date (YYYY-MM-DD) not before the
    COMMIT's date (so the card does not depend on when it is computed) and names a mutant that SURVIVED (`surviving`: id -> index); anything else is returned as rejected, with the reason, and the mutant stays a survivor.
    Returns ({id: reason}, [rejected strings])."""
    if not path: return {}, []
    data = safe_read(ctx, path)
    if data is None: return {}, [f"{path}: not readable at the pinned commit"]
    day, ok, bad = ctx["commit_date"][:10], {}, []
    for n, raw in enumerate(data.decode(errors="replace").split("\n"), 1):
        if not raw.strip() or raw.lstrip().startswith("#"): continue
        f = raw.split("\t")
        if len(f) != 3 or len(f[1].strip()) < 20: bad.append(f"line {n}: needs `id TAB reason (20+ characters) TAB expiry`")
        elif not re.fullmatch(r"\d{4}-\d{2}-\d{2}", f[2].strip()): bad.append(f"line {n}: the expiry is not YYYY-MM-DD")
        elif f[2].strip() < day: bad.append(f"line {n}: expired {f[2].strip()} (the commit is of {day})")
        elif f[0] not in surviving: bad.append(f"line {n}: {f[0]} is not a surviving mutant (stale id, or the tests kill it)")
        else: ok[f[0]] = f[1].strip()
    return ok, bad


@measure("efficiency.throughput_vs_best")
def _(ctx):
    b = ctx["adapter"]["bench"]
    if not b["cmd"]: raise NotMeasurable("the subject declares no bench (adapter [bench] cmd is empty)")
    rc, out, _ = run_cmd(ctx, b["cmd"], b["timeout_seconds"])
    if rc in (None, 124): raise Fail(f"bench timed out after {b['timeout_seconds']} s")
    if rc: raise Fail(f"bench exited {rc}: ...{tail(out)}")
    subj = re.findall(r"^subject (\d+(?:\.\d+)?)$", out, re.M); comp = {n: float(v) for n, v in re.findall(r"^comparator (\S+) (\d+(?:\.\d+)?)$", out, re.M)}
    prov = {n: {"version": v, "sha256": h, "inputs_sha256": i} for n, v, h, i in re.findall(r"^provenance (\S+) (\S+) ([0-9a-f]{64}) (\S+)$", out, re.M)}
    corpus = re.search(r"^corpus ([0-9a-f]{64}) (\d+)$", out, re.M)
    if not subj: raise NotMeasurable("the bench printed no `subject MB_PER_S` line")
    if not corpus: raise NotMeasurable("the bench did not name its corpus (`corpus SHA256 BYTES`): the same corpus for every number must be shown")
    names = [c["name"] for c in b["comparators"]]
    s = float(subj[0]); extra = {"subject_mb_s": s, "comparators_mb_s": comp, "comparator_provenance": prov, "corpus": {"sha256": corpus.group(1), "bytes": int(corpus.group(2))}}
    missing = [n for n in names if n not in comp or n not in prov]
    if missing: raise NotMeasurable("comparators without a number and a pinned version and hash: " + ", ".join(missing) + " (partial numbers: subject " + subj[0] + " MB/s, " + (", ".join(f"{k} {v}" for k, v in sorted(comp.items())) or "none") + ")")
    best = max((comp[c["name"]], c["name"]) for c in b["comparators"] if c["scalar"])
    rows = re.findall(r"^corpusrow (\S+) ([0-9a-f]{64}) (\d+)((?: [A-Za-z0-9._-]+=\d+(?:\.\d+)?)+)$", out, re.M)   # reported, never floored: the same measurement on more corpora (the floor is the primary corpus above)
    if rows:
        scal = [c["name"] for c in b["comparators"] if c["scalar"]]; fl = next(m["floor"][1] for m in METRICS if m["id"] == "efficiency.throughput_vs_best"); cor = []
        for name, sha, nbytes, kv in rows:
            mb = {k: float(v) for k, v in (x.split("=") for x in kv.split())}
            lack = [n for n in ["subject"] + names if n not in mb]
            if lack: raise NotMeasurable(f"corpus row {name} lacks: {', '.join(lack)}")
            bs = max((mb[n], n) for n in scal)
            cor.append({"name": name, "sha256": sha, "bytes": int(nbytes), "mb_s": mb, "best_scalar": bs[1], "percent_of_best_scalar": round(100 * mb["subject"] / bs[0], 1) if bs[0] else 0.0})
        extra["corpora"] = cor; extra["corpora_at_or_above_floor"] = sum(1 for c in cor if c["percent_of_best_scalar"] >= fl); extra["corpora_floor_percent"] = fl
    extra.update(best_scalar=best[1], gap_to_best_scalar_x=round(best[0] / s, 2) if s else None,
                 gap_to_non_scalar_x={c["name"]: round(comp[c["name"]] / s, 1) if s else None for c in b["comparators"] if not c["scalar"]})
    return round(100 * s / best[0], 1) if best[0] else 0.0, extra



def carveouts(ctx, out):
    """DECISIONS 20: the specified share is over everything OUTSIDE the named carve-outs and its floor stays 100. A carve-out is a line `NAME | LEDGER-ID | PROTECTED-PATHS` of the subject's list; it counts only while (1) the subject's trust ledger has that entry (the documented reason),
    (2) every path it names is in the subject's protected list, (3) the closure output's carve-out mass is within the subject's baseline (it may only shrink without approval). The card shows each carve-out, its ledger entry and the mass. Anything else is a failure naming it."""
    c = ctx["adapter"]["proof"]; rd = lambda f: (safe_read(ctx, f) or b"").decode(errors="replace")
    lst = [[x.strip() for x in l.split("|")] for l in rd(c["carveouts"]).splitlines() if l.strip() and not l.lstrip().startswith("#")]
    led, prot = rd(ctx["adapter"]["trust"]["ledger"]), [l.split("#")[0].strip().lstrip("?") for l in rd(c["carveouts_protected"]).splitlines()]
    shown = []
    for row in lst:
        if len(row) != 3 or not all(row): raise Fail(f"carve-out line {row!r}: want 'NAME | LEDGER-ID | PROTECTED-PATHS'")
        name, lid, paths = row
        m = re.search(r"(?ms)^### " + re.escape(lid) + r"\. (.*?)$(.*?)(?=^### |^## |\Z)", led)
        if not m: raise Fail(f"carve-out {name}: the trust ledger has no entry {lid}: an undocumented carve-out is refused")
        plan = re.search(r"^- \*\*Plan:\*\* (.*)$", m.group(2), re.M)
        for pth in (x.strip() for x in paths.split(",")):
            if not any(pth == e or (e.endswith("/") and pth.startswith(e)) for e in prot if e): raise Fail(f"carve-out {name}: {pth} is not in the subject's protected list: a carve-out whose files can change unapproved is refused")
        shown.append({"name": name, "ledger": lid, "entry": m.group(1).strip(), "reason": (plan.group(1) if plan else "")[:400], "protected_by": paths})
    mm = re.search(c["carveouts_regex"], out); bl = re.search(r"^carveout_mass ([0-9]+)$", rd(c["carveouts_baseline"]), re.M)
    if not mm or not bl: raise NotMeasurable("the carve-out mass is missing from the closure output or the baseline has no `carveout_mass N` line: the carve-outs cannot be bounded")
    nodes = int(mm.group(1))
    if nodes > int(bl.group(1)): raise Fail(f"the carve-outs grew to {nodes} nodes, above the subject's baseline {bl.group(1)}: widening a carve-out needs approval at the subject")
    return {"carveouts": shown, "carveout_nodes": nodes, "carveout_baseline_nodes": int(bl.group(1))}



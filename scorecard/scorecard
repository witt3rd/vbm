def case_calls(text, names):
    """Count the calls to one of `names` whose arguments contain a string or bytes literal: the hand-written input cases of a test file (calls whose arguments are variables, as in a vector-loading driver, are not)."""
    n = 0
    for m in re.finditer(r"(?<![\w$])(?:[\w$]+(?:\.|::))*(?:" + "|".join(map(re.escape, names)) + r")\s*\(", text):
        if re.search(r"\b(?:fn|def|function)\s+$", text[max(0, m.start() - 20):m.start()]): continue   # a definition, not a call
        j, depth, q, lit = m.end(), 1, None, False
        while j < len(text) and depth:
            ch = text[j]
            if q:
                if ch == "\\": j += 1
                elif ch == q: q = None
            elif ch in "\"'`": q, lit = ch, True
            elif ch == "(": depth += 1
            elif ch == ")": depth -= 1
            j += 1
        n += lit
    return n


@measure("construction.hand_written_tests")
def _(ctx):
    t = ctx["adapter"]["tests"]; gen = set(matching(ctx, t["generated"]))
    gate = set(matching(ctx, t["gate_selftests"]))
    files = sorted((set(matching(ctx, TEST_PATTERNS)) | set(matching(ctx, t["extra"]))) - gen - gate)
    cases = {}
    for f in files:
        data = safe_read(ctx, f)
        cases[f] = 1 if not t["entry_points"] or data is None else case_calls(data.decode(errors="replace"), t["entry_points"])   # an unreadable file is counted (one case), never waved through
    for f in t["scenario_files"]:
        if f in cases: cases[f] = max(cases[f], 1)
    tests = {f: n for f, n in cases.items() if n}
    return sum(tests.values()), {"files": sorted(tests), "cases_by_file": tests, "drivers": sorted(f for f, n in cases.items() if not n), "generated_excluded": len(gen), "gate_selftests_excluded": len(gate)}


@measure("velocity.tier1_seconds_cold")
def _(ctx):
    rc, out, secs = tier1_run(ctx)
    if rc is None: raise Fail(f"tier1 timed out after {ctx['adapter']['tier1']['timeout_seconds']} s")
    if rc: raise Fail(f"tier1 exited {rc}: ...{tail(out)}", secs)
    return secs, {"command": ctx["adapter"]["tier1"]["command"][:200], "measured": True}   # a wall-clock measurement: the one kind of value that varies between two runs of the same commits (SPEC rule 1)


@measure("velocity.tier1_seconds_warm")
def _(ctx):
    t = ctx["adapter"]["tier1"]
    if not t["warm_command"]: raise NotMeasurable("the adapter declares no warm run ([tier1] warm_change_cmd, warm_command, warm_timeout_seconds): what a landing costs was not measured")
    rc, out, _ = tier1_run(ctx); ph = ctx["phases"]; w, ch = ph.get("warm"), ph.get("change")
    if rc != 0: raise Fail("the cold run, which primes the cache the warm run needs, did not pass: no warm run")
    if ch is None or ch["rc"] != 0: raise Fail(f"the typical change (warm_change_cmd) failed (exit {None if ch is None else ch['rc']}): no warm run")
    if w is None or w["secs"] is None or w["rc"] is None: raise Fail(f"the warm run timed out after {t['warm_timeout_seconds']} s")
    if w["rc"]: raise Fail(f"the warm gate exited {w['rc']}: ...{tail(w['out'])}", w["secs"])
    names = [g["name"] for g in t["gates"] if g["name"] not in t["warm_skips"]]
    missing = [g["name"] for g in t["gates"] if g["name"] in names and not re.search(g["selftest"], w["out"], re.M)]
    if missing: raise Fail(f"the warm gate exited 0 without the self-test evidence of: {', '.join(missing)} (a fast run that does not show its gates ran is not the gate)", w["secs"])
    return w["secs"], {"change_command": t["warm_change_cmd"][:200], "command": t["warm_command"][:200], "gates_shown": names, "gates_skipped": list(t["warm_skips"]), "measured": True}


@measure("velocity.open_prs")
def _(ctx):
    m = re.search(r"github[^:/]*[:/]([^/]+/[^/]+?)(?:\.git)?$", git(ctx["repo"], "remote", "get-url", "origin", check=False).strip())
    if not m: raise NotMeasurable("the subject has no GitHub origin remote")
    try: r = subprocess.run([os.environ.get("SCORECARD_GH", "gh"), "pr", "list", "-R", m.group(1), "--state", "open", "--json", "number", "--limit", "500"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e: raise NotMeasurable(f"gh unavailable: {e}")
    if r.returncode: raise NotMeasurable("gh pr list failed: " + (r.stderr.strip().splitlines() or ["?"])[-1])
    return len(json.loads(r.stdout)), {"repo": m.group(1)}


def window(ctx):   # (committer time, author time) of first-parent commits within window_hours before the pinned commit's committer date
    rows = [tuple(map(int, l.split())) for l in git(ctx["repo"], "log", "--first-parent", "--format=%ct %at", ctx["commit"]).splitlines()]
    return [r for r in rows if r[0] >= rows[0][0] - ctx["adapter"]["velocity"]["window_hours"] * 3600]


@measure("velocity.commits_per_hour")
def _(ctx):
    w = window(ctx); span = max(3600, max(r[0] for r in w) - min(r[0] for r in w))
    return round(len(w) / (span / 3600), 3), {"commits": len(w), "span_seconds": span}


@measure("velocity.p90_commit_to_main_seconds")
def _(ctx):
    rows = [tuple(map(int, l.split())) for l in git(ctx["repo"], "log", "--first-parent", "--format=%ct %at", ctx["commit"]).splitlines()]
    w = [r for r in rows if r[0] >= rows[0][0] - ctx["adapter"]["velocity"]["window_hours"] * 3600]   # newest first
    batches, cur = [], [w[0]]
    for r in w[1:]:
        if cur[-1][0] - r[0] <= 120: cur.append(r)
        else: batches.append(cur); cur = [r]
    batches.append(cur)
    d = sorted(max(0, max(c for c, _ in b) - min(a for _, a in b)) for b in batches)
    if not any(d): raise NotMeasurable("every change in the window reads 0 s: the history records no authoring start before the landing (squash merges and commits made on main rewrite or equal the dates)")
    return d[-(-9 * len(d) // 10) - 1], {"changes": len(d), "changes_with_a_recorded_start": sum(1 for x in d if x)}


def open_subject(a):
    """Common to both levels: refuse a repo that is not allowlisted, resolve the pinned commit, check the launcher, clone the commit into a scratch dir (nothing of it is run). Returns (repo, commit, launcher, scratch, wt)."""
    repo = os.path.abspath(a.repo)
    if not os.path.isdir(repo): raise Reject(f"no such repo: {repo}")
    refused = scorecard_policy.check(repo, GIT_ENV, a.allowlist or scorecard_policy.ALLOWLIST)
    if refused: raise Reject(refused)
    commit = git(repo, "rev-parse", "--verify", "-q", a.commit + "^{commit}", check=False).strip()
    if not commit: raise Reject(f"no such commit in {repo}: {a.commit}")
    launcher = os.path.abspath(a.sandbox) if a.sandbox else None
    if launcher and not (os.path.isfile(launcher) and os.access(launcher, os.X_OK)): raise Reject(f"the sandbox launcher is not an executable file: {launcher}")
    scratch = tempfile.mkdtemp(prefix="scorecard-")
    try:
        r = subprocess.run(["git", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", "clone", "-q", "--no-checkout", "--", repo, scratch + "/wt"], capture_output=True, text=True, env=GIT_ENV)
        if r.returncode: raise Reject(f"cannot clone {repo}: {r.stderr.strip()}")
        git(scratch + "/wt", "checkout", "-q", "--detach", commit)
    except BaseException: shutil.rmtree(scratch, ignore_errors=True); raise
    return repo, commit, launcher, scratch, scratch + "/wt"


def cmd_run(a):
    repo, commit, launcher, scratch, wt = open_subject(a)
    try:
        origin = git(repo, "remote", "get-url", "origin", check=False).strip()
        try: pins = scorecard_pins.provision(wt, GIT_ENV, a.allowlist or scorecard_policy.ALLOWLIST, allow_local=not origin or origin.startswith(("/", ".", "file://")))   # host-side, before any sandbox: the sandbox never fetches
        except ValueError as x: raise Reject(f"a pinned library cannot be provisioned: {x}")
        text = open(a.adapter).read() if a.adapter else git(wt, "show", "HEAD:scorecard.toml", check=False)
        if not text: raise Reject(f"no adapter: {commit[:12]} has no scorecard.toml and --adapter was not given")
        adapter = load_adapter(text)
        sc_sha = git(HERE, "rev-parse", "HEAD", check=False).strip() or None
        dirty = bool(git(HERE, "status", "--porcelain", "--", ".", check=False).strip()) if sc_sha else None
        ctx = dict(repo=repo, wt=wt, commit=commit, commit_date=git(repo, "log", "-1", "--format=%cI", commit).strip(), adapter=adapter, adapter_sha=hashlib.sha256(text.encode()).hexdigest(), scorecard={"sha": sc_sha, "dirty": dirty},
                   scratch=scratch, sandbox=launcher, pins=pins, n_exec=0, attestations=[], skipped=set(), sandbox_info=None)
        if launcher: ctx["sandbox_info"] = {"launcher_sha256": hashlib.sha256(open(launcher, "rb").read()).hexdigest(), "limits": LIMITS, "attestations": ctx["attestations"]}
        card = build_card(ctx)
    finally:
        if a.keep: print(f"scorecard: scratch kept at {scratch}", file=sys.stderr)
        else: shutil.rmtree(scratch, ignore_errors=True)
    out = json.dumps(card, indent=2) + "\n"
    if a.out: open(a.out, "w").write(out)
    else: sys.stdout.write(out)
    return 0


def main(argv):
    p = argparse.ArgumentParser(prog="scorecard"); sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run"); r.add_argument("--repo", required=True); r.add_argument("--commit", required=True); r.add_argument("--adapter"); r.add_argument("--out")
    r.add_argument("--sandbox"); r.add_argument("--keep", action="store_true"); r.add_argument("--allowlist", help="the allowlist file (self-test only; default registry/allowlist.toml)")
    c = sub.add_parser("certify", help="Level 1: Certified (runs no code of the subject)"); c.add_argument("--repo", required=True); c.add_argument("--commit", required=True); c.add_argument("--manifest", default="vbm-proof.toml"); c.add_argument("--out")
    c.add_argument("--sandbox"); c.add_argument("--keep", action="store_true"); c.add_argument("--allowlist")
    a = p.parse_args(argv)
    try: return cmd_run(a) if a.cmd == "run" else scorecard_certify.run(a, sys.modules[__name__])
    except Reject as e: print(f"scorecard: {e}", file=sys.stderr); return 2


if __name__ == "__main__": sys.exit(main(sys.argv[1:]))

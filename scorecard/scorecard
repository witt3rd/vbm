MEASURES = {}   # metric id -> function(ctx) -> (value, extra dict); registered below


class NotMeasurable(Exception): pass
class Fail(Exception):
    def __init__(self, reason, value=None, extra=None): super().__init__(reason); self.reason, self.value, self.extra = reason, value, extra or {}
class Reject(Exception): pass    # bad input: exit 2
class MetricTimeout(BaseException): pass


def measure(mid):
    def reg(f): MEASURES[mid] = f; return f
    return reg


def git(repo, *a, check=True):
    r = subprocess.run(["git", "-C", repo, "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", *a], capture_output=True, text=True, env=GIT_ENV)
    if check and r.returncode: raise Reject(f"git {' '.join(a[:2])} failed in {repo}: {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else r.returncode}")
    return r.stdout


def load_adapter(text):
    try: d = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e: raise Reject(f"adapter: not valid TOML: {e}")
    for sec, keys in ADAPTER.items():
        if not isinstance(d.get(sec), dict): raise Reject(f"adapter: missing section [{sec}]")
        for k, t in keys.items():
            if k not in d[sec]: raise Reject(f"adapter: missing key [{sec}] {k}")
            v = d[sec][k]
            if isinstance(v, bool) or not isinstance(v, t) or (t is list and (sec, k) != ("bench", "comparators") and not all(isinstance(x, str) for x in v)):
                raise Reject(f"adapter: [{sec}] {k} must be {getattr(t, '__name__', 'a number')}")
        for k, t in OPTIONAL.get(sec, {}).items():
            if k in d[sec] and not isinstance(d[sec][k], t): raise Reject(f"adapter: [{sec}] {k} must be {t.__name__}")
            d[sec].setdefault(k, t())
        for k in d[sec]:
            if k not in keys and k not in OPTIONAL.get(sec, {}): raise Reject(f"adapter: unknown key [{sec}] {k}")
    for sec in d:
        if sec not in ADAPTER: raise Reject(f"adapter: unknown section [{sec}]")
    for sec, k in PATH_KEYS + [(sc, "equivalent") for sc in ("mutation", "nonvacuity") if d[sc]["equivalent"]]:
        for v in (d[sec][k] if isinstance(d[sec][k], list) else [d[sec][k]]):
            if v.startswith("/") or ".." in v.split("/") or "\0" in v: raise Reject(f"adapter: [{sec}] {k}: an absolute path or '..' is not allowed: {v!r}")
    for k in ("sorry_pattern", "closure_regex"):
        try: re.compile(d["proof"][k])
        except re.error as e: raise Reject(f"adapter: [proof] {k} is not a valid regex: {e}")
    cs = d["bench"]["comparators"]
    if not all(isinstance(c, dict) and set(c) == {"name", "scalar"} and isinstance(c["name"], str) and re.fullmatch(r"[A-Za-z0-9._-]+", c["name"]) and isinstance(c["scalar"], bool) for c in cs): raise Reject("adapter: [bench] comparators must be a list of {name = \"...\", scalar = true|false}")
    if d["bench"]["cmd"] and not any(c["scalar"] for c in cs): raise Reject("adapter: [bench] comparators needs at least one scalar comparator (the efficiency floor is against the best scalar one)")
    for sec in ("mutation", "nonvacuity"):
        if not 1 <= d[sec]["mutants"] <= 200: raise Reject(f"adapter: [{sec}] mutants must be 1..200 (the budget of DECISIONS 8)")
    gs = d["tier1"]["gates"]
    if not all(isinstance(g, dict) and set(g) == {"name", "selftest"} and isinstance(g["name"], str) and g["name"].strip() and isinstance(g["selftest"], str) for g in gs):
        raise Reject("adapter: [tier1] gates must be a list of {name = \"...\", selftest = \"REGEX\"}")
    if len({g["name"] for g in gs}) != len(gs): raise Reject("adapter: [tier1] gates: a gate is named once")
    for g in gs:
        try: re.compile(g["selftest"])
        except re.error as e: raise Reject(f"adapter: [tier1] gates {g['name']!r}: selftest is not a valid regex: {e}")
        if len(g["selftest"]) < 12: raise Reject(f"adapter: [tier1] gates {g['name']!r}: a selftest pattern shorter than 12 characters would match almost any output")
    t1 = d["tier1"]
    if bool(t1["warm_command"]) != bool(t1["warm_change_cmd"]): raise Reject("adapter: [tier1] warm_change_cmd and warm_command are declared together (the warm run is the gate after a typical change)")
    if t1["warm_command"] and not 1 <= t1["warm_timeout_seconds"] <= 1800: raise Reject("adapter: [tier1] warm_timeout_seconds must be 1..1800 when a warm run is declared")
    if t1["warm_command"] and not t1["gates"]: raise Reject("adapter: [tier1] a warm run needs [tier1] gates (the warm output must show the gates ran)")
    if not all(isinstance(x, str) for x in t1["warm_skips"]) or not set(t1["warm_skips"]) <= {g["name"] for g in t1["gates"]}: raise Reject("adapter: [tier1] warm_skips names declared gates only")
    if t1["warm_skips"] and len(set(t1["warm_skips"])) >= len(t1["gates"]): raise Reject("adapter: [tier1] warm_skips cannot name every gate (the warm run must show at least one gate ran)")
    if d["subject"]["kind"] not in KINDS: raise Reject(f"adapter: [subject] kind must be one of {KINDS}")
    if d["subject"]["kind"] == "library" and d["floors"]["specified_share"] != 100: raise Reject("adapter: a library's [floors] specified_share is 100 (DECISIONS 1); a boundary that cannot be specified is a documented carve-out (DECISIONS 20), never a lower floor")
    pr = d["proof"]
    if any(pr[k] for k in ("carveouts_protected", "carveouts_regex", "carveouts_baseline")) and not pr["carveouts"]: raise Reject("adapter: [proof] carveouts_* keys need [proof] carveouts (the list of carve-outs)")
    if pr["carveouts"]:
        if not (pr["carveouts_protected"] and pr["carveouts_regex"] and pr["carveouts_baseline"]): raise Reject("adapter: [proof] carveouts needs carveouts_protected (the subject's protected list), carveouts_regex (the carve-out mass in the closure output) and carveouts_baseline (the file whose `carveout_mass N` line the mass may not exceed)")
        try: re.compile(pr["carveouts_regex"])
        except re.error as e: raise Reject(f"adapter: [proof] carveouts_regex is not a valid regex: {e}")
    return d


def judge(m, value, adapter):
    if m["floor"] is None: return "pass", None
    op, ref = m["floor"]
    if op == "adapter": op, ref = ">=", adapter["floors"][ref]
    ok = {"==": value == ref, ">=": value >= ref, "<": value < ref, "<=": value <= ref}[op]
    return ("pass" if ok else "fail"), {"op": op, "value": ref}


class alarm:   # a wall-clock limit on a static metric; the regex engine checks signals, so a catastrophic adapter pattern is stopped
    def __init__(self, secs): self.secs = secs
    def __enter__(self):
        def h(*_): raise MetricTimeout()
        if self.secs: signal.signal(signal.SIGALRM, h); signal.setitimer(signal.ITIMER_REAL, self.secs)
    def __exit__(self, *_): signal.setitimer(signal.ITIMER_REAL, 0)


def build_card(ctx):
    metrics = []
    for m in METRICS:
        if m.get("needs") and not ctx["adapter"][m["needs"][0]][m["needs"][1]]: continue   # a metric for a target the adapter does not declare is not listed
        e = {"id": m["id"], "dimension": m["dim"], "dir": m["dir"], "definition": m["desc"], "implemented": m["id"] in MEASURES, "value": None, "floor": None}
        if m["floor"]: e["floor"] = {"op": m["floor"][0], "value": m["floor"][1]} if m["floor"][0] != "adapter" else {"op": ">=", "value": ctx["adapter"]["floors"][m["floor"][1]]}
        try:
            if m["id"] not in MEASURES: raise NotMeasurable("not implemented in this runner version")
            with alarm(0 if m["id"] in EXECUTING else METRIC_SECONDS): e["value"], extra = MEASURES[m["id"]](ctx)
            e["status"], _ = judge(m, e["value"], ctx["adapter"]); e.update(extra)
        except MetricTimeout: e["status"], e["reason"] = "not-measurable", f"the metric ran over {METRIC_SECONDS} s (a hostile or runaway pattern): stopped"
        except NotMeasurable as x: e["status"], e["reason"] = "not-measurable", str(x)
        except Fail as x: e["status"], e["reason"], e["value"] = "fail", x.reason, x.value; e.update(x.extra)
        metrics.append(e)
    dims = {}
    for e in metrics:
        if e["floor"] is None: continue
        d = dims.setdefault(e["dimension"], {"status": "pass", "below_floor": [], "below_floor_implemented": []})
        if e["status"] != "pass":   # fail, or not-measurable (DECISIONS 6: not-measurable fails the floor)
            d["status"] = "fail"; d["below_floor"].append(e["id"])
            if e["implemented"]: d["below_floor_implemented"].append(e["id"])
    card = {"schema": SCHEMA_VERSION, "scorecard": ctx["scorecard"], "subject": {"name": ctx["adapter"]["subject"]["name"], "kind": ctx["adapter"]["subject"]["kind"], "commit": ctx["commit"], "commit_date": ctx["commit_date"]},
            "adapter": {"sha256": ctx["adapter_sha"]}, "sandbox": ctx["sandbox_info"], "skipped_files": sorted(ctx["skipped"]), "metrics": metrics, "dimensions": dims, **({"pinned_libs": ctx["pins"]} if ctx.get("pins") else {})}
    card["verdicts"] = scorecard_verdicts.verdicts(card)
    return card


CLOCK = time.monotonic   # the host clock that times every measured phase (a module name so a self-test can shift it: scripts/test_scorecard.sh)


def sh(argv, timeout, env, cwd=None, nonce=None, marks=None):
    """Run argv (a launcher, never subject code directly) in its own session; kill that process group on timeout or when the output passes OUT_CAP. Returns (rc, output, seconds); rc is None on a timeout, -9 on a flood.
    With a nonce, every output line `@@scorecard NONCE LABEL RC` (printed by the runner's own wrapper script) is stamped with the HOST clock at the moment it ARRIVES and appended to `marks` as (label, rc, time): the phases of a run are timed
    by the runner, never by a clock or a number the subject's code reports (a line without the nonce is just output)."""
    t0, hit = CLOCK(), []
    p = subprocess.Popen(argv, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
    def kill():
        try: os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError: pass
    tm = threading.Timer(timeout, lambda: (hit.append(1), kill())); tm.start()
    buf, seen, tag = b"", 0, f"@@scorecard {nonce} ".encode()
    while len(buf) <= OUT_CAP and (c := os.read(p.stdout.fileno(), 65536)):   # os.read returns what has arrived (a buffered read would wait for a full block and blur the phase times)
        buf += c; now = CLOCK()
        while nonce and (nl := buf.find(b"\n", seen)) >= 0:
            line, seen = buf[seen:nl], nl + 1
            if line.startswith(tag) and len(f := line[len(tag):].split()) == 2 and f[1].lstrip(b"-").isdigit(): marks.append((f[0].decode(errors="replace"), int(f[1]), now))
    if len(buf) > OUT_CAP: kill()
    p.stdout.close(); p.wait(); tm.cancel()
    return (None if hit else p.returncode), buf[:OUT_CAP].decode(errors="replace"), round(CLOCK() - t0, 1)



          "cwd": "lib/vbm-memory"
        }
      ]
    },
    {
      "name": "vbm-prob",
      "paths": [
        "lib/vbm-prob/*"
      ],
      "steps": [
        {
          "run": "mise exec -- scripts/repo-gates.sh"
        },
        {
          "run": "mise exec -- scripts/tier1.sh",
          "cwd": "lib/vbm-prob"
        }
      ]
    },
    {
      "name": "vbm-rng",
      "paths": [
        "lib/vbm-rng/*"
      ],
      "steps": [
        {
          "run": "mise exec -- scripts/repo-gates.sh"
        },
        {
          "run": "mise exec -- scripts/tier1.sh",
          "cwd": "lib/vbm-rng"
        }
      ]
    },
    {
      "name": "vbm-scoreboard",

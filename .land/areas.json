        "lib/vbm-scoreboard/*"
      ],
      "steps": [
        {
          "run": "mise exec -- scripts/repo-gates.sh"
        },
        {
          "run": "mise exec -- scripts/tier1.sh",
          "cwd": "lib/vbm-scoreboard"
        }
      ]
    },
    {
      "name": "vbm-work",
      "paths": [
        "lib/vbm-work/*"
      ],
      "steps": [
        {

{
  "version": 1,
  "areas": [
    {
      "name": "hub",
      "paths": [
        ".agents/*",
        ".gitignore",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "MANIFESTO.md",
        "NOTICE",
        "README.md",
        "ROADMAP.md",
        "SECURITY.md",
        "VERSION",
        "docs/*",
        "guidelines/*",
        "mise.toml",
        "project.toml",
        "registry/*",
        "scorecard/*",
        "scripts/*",
        "skills/*"
      ],
      "steps": [
        {
          "run": "mise exec -- scripts/repo-gates.sh"
        },
        {
          "run": "mise exec -- scripts/tier1.sh"
        }
      ]
    },
    {
      "name": "vbm-decision",
      "paths": [
        "lib/vbm-decision/*"
      ],
      "steps": [
        {
          "run": "mise exec -- scripts/repo-gates.sh"
        },
        {
          "run": "mise exec -- scripts/tier1.sh",
          "cwd": "lib/vbm-decision"
        }
      ]
    },
    {
      "name": "vbm-forecast",
      "paths": [
        "lib/vbm-forecast/*"
      ],
      "steps": [
        {
          "run": "mise exec -- scripts/repo-gates.sh"
